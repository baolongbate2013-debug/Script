-- Logic băm mã chuẩn Plato
local function lDigest(input)
    local hashHex = ""
    for i = 1, #tostring(input) do
        hashHex = hashHex .. string.format("%02x", string.byte(tostring(input), i))
    end
    return hashHex
end

