        if HitboxActive then
            hrp.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
            hrp.Transparency = 0.7                  -- Làm trong suốt để dễ nhìn
            hrp.Color = Color3.fromRGB(0, 191, 255)  -- Màu xanh dương Neon rực rỡ
