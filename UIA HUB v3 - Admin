-- Nút gạt Tự động lặp lại nhạc
ReplayToggle = BoomboxTab:Toggle({
    Title = "🔄 Auto Lặp Lại Nhạc",
    Desc = "Tự động phát lại bài hát khi nhạc kết thúc",
    Value = false,
    Callback = function(state)
        AutoReplay = state
        if AutoReplay then
            task.spawn(function()
                while AutoReplay do
                    -- Đã có CurrentTrackId hợp lệ ở trên gài vào nên sẽ lặp chuẩn 100%
                    if CurrentTrackId ~= "" and not LocalSound.IsPlaying and LocalSound.SoundId ~= "" then
                        LocalSound:Play()
                    end
                    task.wait(1)
                end
            end)
            WindUI:Notify({ Title = "Auto Replay", Content = "Đã BẬT Tự Động Lặp Nhạc!", Duration = 2, Icon = "refresh-cw" })
        else
            WindUI:Notify({ Title = "Auto Replay", Content = "Đã TẮT Tự Động Lặp Nhạc!", Duration = 2, Icon = "x" })
        end
    end
})

