-- 💡 BỔ SUNG QUAN TRỌNG: Khai báo đầy đủ các biến hệ thống bị thiếu ở đầu code
_G.IdBoombox = "" 
local AutoReplay = false
local CurrentTrackId = "" -- Biến ghi nhớ bài hát đang phát thực tế
local ReplayToggle = nil  -- Biến điều khiển nút gạt từ xa

-- Hàm phát nhạc từ ID
local function StartMusic(id, name)
    if not id or id == "" then return end
    
    -- SỬA LỖI 2: Phải găm ID vào đây thì hệ thống Auto Replay bên dưới mới nhận diện được bài để lặp!
    CurrentTrackId = tostring(id) 
    
    LocalSound:Stop()
    LocalSound.SoundId = "rbxassetid://" .. CurrentTrackId
    LocalSound:Play()
    
    WindUI:Notify({
        Title = "Thành Công",
        Content = "Đang phát bài: " .. (name or id),
        Duration = 4,
        Icon = "music"
    })
end

