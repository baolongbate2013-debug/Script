        -- Chạy vòng lặp liên tục để quét và giữ nguyên kích thước Hitbox (phòng trường hợp địch hồi sinh)
        if HitboxActive then
            task.spawn(function()
                while HitboxActive do
                    for _, v in pairs(game.Players:GetPlayers()) do
                        ApplyHitbox(v)
                    end
                    task.wait(1) -- Quét lại mỗi giây cho nhẹ game
                end
            end)
        else
            -- Khi tắt gạt thì reset tất cả mọi người về bình thường
            for _, v in pairs(game.Players:GetPlayers()) do
                ApplyHitbox(v)
            end
        end
    end
})

